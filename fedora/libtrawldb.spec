Name:           libtrawldb
Version:        0.1.1
Release:        1%{?dist}
Summary:        C library to interact with trawl.
License:        Apache-2.0
URL:            https://github.com/regolith-linux/libtrawldb
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  make
BuildRequires:  meson
BuildRequires:  gcc
BuildRequires:  pkgconfig(glib-2.0)

Requires:       trawld

%description
C library to interact with trawl.

%prep
%autosetup -n %{name}-%{version}

%build
%set_build_flags
%make_build -f fedora/Makefile build MESON_FLAGS="--buildtype=plain"

%install
%make_install -f fedora/Makefile PREFIX=%{_prefix} LIBDIR=%{_libdir} SYSCONFDIR=%{_sysconfdir}
# single-binary compiled package: own everything the build installed
(cd %{buildroot} && find . \( -type f -o -type l \) | sed 's|^\.||' \
   | sed -E 's|^(/usr/lib/python3[^/]*/site-packages/[^/]+)/.*|\1|; s|^(/usr/share/man/.*)$|\1*|' \
   | sort -u | sed -E 's|^(/etc/.*)$|%config(noreplace) \1|') > libtrawldb.files

%files -f libtrawldb.files

